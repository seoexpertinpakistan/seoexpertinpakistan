  <script>
    window.addEventListener('load', function() {
        const wrap = document.getElementById('v2-why-wrap');
        const track = document.getElementById('v2-track');
        const viewport = document.getElementById('v2-viewport');
        if (!wrap || !track || !viewport) return;
        
        let maxTranslate = 0;
        
        function setupDimensions() {
            if (window.innerWidth <= 1024) return;
            const cards = track.querySelectorAll('.v2-card');
            if (cards.length === 0) return;
            const lastCard = cards[cards.length - 1];
            maxTranslate = (lastCard.offsetLeft + lastCard.offsetWidth) - viewport.clientWidth;
            if (maxTranslate < 0) maxTranslate = 0;
        }
        
        function updateScroll() {
            if (window.innerWidth <= 1024) return;
            const rect = wrap.getBoundingClientRect();
            const scrollableHeight = wrap.offsetHeight - window.innerHeight;
            
            if (rect.top <= 80 && rect.bottom >= window.innerHeight) {
                let progress = (80 - rect.top) / scrollableHeight;
                progress = Math.max(0, Math.min(1, progress));
                track.style.transform = `translateX(-${progress * maxTranslate}px)`;
            } else if (rect.top > 80) {
                track.style.transform = 'translateX(0px)';
            } else if (rect.bottom < window.innerHeight) {
                track.style.transform = `translateX(-${maxTranslate}px)`;
            }
        }
        
        // Initialize
        setupDimensions();
        updateScroll();
        
        // Smooth Scroll Listener
        let ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                window.requestAnimationFrame(function() {
                    updateScroll();
                    ticking = false;
                });
                ticking = true;
            }
        }, { passive: true });
        
        window.addEventListener('resize', function() {
            setupDimensions();
            updateScroll();
        });
    });
</script>
