        (function() {
            const items = document.querySelectorAll('.cb-item');
            const progress = document.getElementById('cb-progress');
            const gridContainer = progress ? progress.parentElement : null;

            function checkScroll() {
                const triggerPoint = window.innerHeight / 2;
                let activeIndex = 0;

                items.forEach((item, i) => {
                    const rect = item.getBoundingClientRect();
                    if (rect.top < triggerPoint && rect.bottom > triggerPoint) {
                        activeIndex = i;
                    }
                });

                items.forEach((item, i) => {
                    (i <= activeIndex) ? item.classList.add('active') : item.classList.remove('active');
                });

                // Calculate progress height
                if (gridContainer && progress) {
                    const gridRect = gridContainer.getBoundingClientRect();
                    const progressHeight = (triggerPoint - gridRect.top) - 15;
                    if (progressHeight > 0 && progressHeight < gridRect.height) {
                        progress.style.height = progressHeight + 'px';
                    } else if (progressHeight >= gridRect.height) {
                        progress.style.height = '100%';
                    } else {
                        progress.style.height = '0%';
                    }
                }
            }
            window.addEventListener('scroll', checkScroll);
