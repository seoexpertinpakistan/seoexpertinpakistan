    </style>

    <script>
        (function() {
            const stage = document.getElementById('toolsStage');
            const nodes = stage.querySelectorAll('.tool-node');
            
            let currentRotation = 0;
            let isSpreadState = false;
            let animationFrameId;
            let lastTime = performance.now();
            let stateTimer = 0;
            let currentSpeed = 30;

            function animate(time) {
                if (window.innerWidth > 768) {
                    const dt = (time - lastTime) / 1000;
                    lastTime = time;
                    stateTimer += dt;
                    
                    if (stateTimer < 4.0) {
                        currentSpeed = 32;
                        if (isSpreadState) {
                            isSpreadState = false;
                            setOrbitMode();
                        }
                        currentRotation += currentSpeed * dt;
                        updateOrbitPositions();
                    } else if (stateTimer < 5.5) {
                        currentSpeed = Math.max(2, 32 * (1 - (stateTimer - 4.0) / 1.5));
                        currentRotation += currentSpeed * dt;
                        updateOrbitPositions();
                    } else if (stateTimer < 8.5) {
                        if (!isSpreadState) {
                            isSpreadState = true;
                            setSpreadMode();
                        }
                    } else if (stateTimer < 10.0) {
                        if (isSpreadState) {
                            isSpreadState = false;
                            setOrbitMode();
                        }
                        currentSpeed = 12;
                        currentRotation += currentSpeed * dt;
                        updateOrbitPositions();
                    } else {
                        stateTimer = 0;
                    }
                }
                animationFrameId = requestAnimationFrame(animate);
            }

            function updateOrbitPositions() {
                const nodeWidth = 135;
                const nodeHeight = 44;
                nodes.forEach(node => {
                    if (!isSpreadState) {
                        const angleDeg = parseFloat(node.style.getPropertyValue('--angle'));
                        const dist = parseFloat(node.style.getPropertyValue('--dist'));
                        const angleRad = (angleDeg + currentRotation) * (Math.PI / 180);
                        const x = Math.cos(angleRad) * dist - (nodeWidth / 2);
                        const y = Math.sin(angleRad) * dist - (nodeHeight / 2);
                        node.style.transform = `translate(${x}px, ${y}px)`;
                    }
                });
            }

            function setSpreadMode() {
                const nodeWidth = 135;
                const nodeHeight = 44;
                nodes.forEach(node => {
                    const gx = parseFloat(node.style.getPropertyValue('--gx')) - (nodeWidth / 2);
                    const gy = parseFloat(node.style.getPropertyValue('--gy')) - (nodeHeight / 2);
                    node.style.transition = 'transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1)';
                    node.style.transform = `translate(${gx}px, ${gy}px)`;
                });
            }

            function setOrbitMode() {
                nodes.forEach(node => {
                    node.style.transition = 'transform 0.8s ease-out';
                });
            }

            if (window.innerWidth > 768) {
                animationFrameId = requestAnimationFrame(animate);
            }

            window.addEventListener('resize', () => {
                if (window.innerWidth <= 768) {
                    cancelAnimationFrame(animationFrameId);
                    nodes.forEach(n => n.style.transform = 'none');
                } else if (!animationFrameId) {
                    lastTime = performance.now();
                    animationFrameId = requestAnimationFrame(animate);
                }
            });
        })();
    </script>
</section>

