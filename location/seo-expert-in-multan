                const triggerPoint = window.innerHeight / 2;
                let activeIndex = 0;

                items.forEach((item, i) => {
                    const rect = item.getBoundingClientRect();
                    if (rect.top < triggerPoint) {
                        item.style.opacity = '1';
                        item.style.transform = 'translateX(0)';
                        activeIndex = i;
