    <!-- HEADER JAVASCRIPT (MOBILE MENU SLIDER LOGIC) -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const navContainer = document.querySelector('.nav-container');
            const mainNav = document.querySelector('.main-nav');
            const triggers = document.querySelectorAll('.mega-trigger');

            if (!navContainer || !mainNav || triggers.length === 0) return;

            // 1. Create Hamburger Button
            const hamburger = document.createElement('button');
            hamburger.className = 'hamburger-btn';
            hamburger.innerHTML = '<span></span><span></span><span></span>';
            hamburger.setAttribute('aria-label', 'Toggle Menu');
            navContainer.appendChild(hamburger);

            // 2. Hamburger Click Logic (Open/Close Main Menu)
            hamburger.addEventListener('click', function(e) {
                e.stopPropagation();
                this.classList.toggle('active');
                mainNav.classList.toggle('open');
                // Reset to parent view every time menu is opened
                mainNav.classList.remove('is-submenu-open');
                triggers.forEach(t => t.classList.remove('is-open'));
            });

            // 3. Inject Back Button & Handle Sub-menu Navigation
            triggers.forEach(trigger => {
                const label = trigger.querySelector('.trigger-label');
                const dropdown = trigger.querySelector('.mega-dropdown');
                
                if (!label || !dropdown) return;
                
                const inner = dropdown.querySelector('.mega-inner');

                // Create Back Button
                const backBtn = document.createElement('div');
                backBtn.className = 'mobile-back-btn';
                backBtn.innerHTML = '← Back to Main Menu';
                
                // Insert Back Button at the top of the dropdown content
                if (inner) {
                    inner.insertBefore(backBtn, inner.firstChild);
                } else {
                    dropdown.insertBefore(backBtn, dropdown.firstChild);
                }

                // Handle Parent Category Click (Open Sub-menu)
                label.addEventListener('click', function(e) {
                    if (window.matchMedia('(max-width: 992px)').matches) {
                        e.preventDefault();
                        e.stopPropagation();
                        triggers.forEach(t => t.classList.remove('is-open'));
                        trigger.classList.add('is-open');
                        mainNav.classList.add('is-submenu-open');
                        mainNav.scrollTop = 0;
                    }
                });

                // Handle Back Button Click (Close Sub-menu, show Parent list)
                backBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    trigger.classList.remove('is-open');
                    mainNav.classList.remove('is-submenu-open');
                });
            });

            // 4. Close menu when clicking a final link inside the sub-menus
            mainNav.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', (e) => {
                    if (window.matchMedia('(max-width: 992px)').matches) {
                        hamburger.classList.remove('active');
                        mainNav.classList.remove('open');
                        mainNav.classList.remove('is-submenu-open');
                        triggers.forEach(t => t.classList.remove('is-open'));
                    }
                });
            });

            // 5. Close menu when clicking outside
            document.addEventListener('click', function(e) {
                if (!mainNav.contains(e.target) && !hamburger.contains(e.target) && mainNav.classList.contains('open')) {
                    hamburger.classList.remove('active');
                    mainNav.classList.remove('open');
                    mainNav.classList.remove('is-submenu-open');
                    triggers.forEach(t => t.classList.remove('is-open'));
                }
            });

            // 6. Reset everything if resized back to desktop
            window.addEventListener('resize', function() {
                if (!window.matchMedia('(max-width: 992px)').matches) {
                    hamburger.classList.remove('active');
                    mainNav.classList.remove('open');
                    mainNav.classList.remove('is-submenu-open');
                    triggers.forEach(t => t.classList.remove('is-open'));
                }
            });
        });
    </script>

    <!-- PRE-LOADER & SCROLL ANIMATION SCRIPTS -->
    <script>
        // Preloader Fade Out
        window.addEventListener('load', function() {
            const preloader = document.getElementById('preloader');
            if (preloader) {
                setTimeout(function() {
                    preloader.classList.add('hidden');
                }, 500); // 0.5 seconds delay for effect
            }
        });

        // Scroll-Triggered Reveal Animation
        document.addEventListener('DOMContentLoaded', function() {
            const reveals = document.querySelectorAll('.reveal');

            function checkReveal() {
                const triggerPoint = 150; // Point from bottom of screen to trigger
                reveals.forEach(reveal => {
                    const revealTop = reveal.getBoundingClientRect().top;
                    if (revealTop < window.innerHeight - triggerPoint) {
                        reveal.classList.add('visible');
                    }
                });
            }

            // Initial check
            checkReveal();
            // Listen for scroll
            window.addEventListener('scroll', checkReveal);
        });
    </script>
